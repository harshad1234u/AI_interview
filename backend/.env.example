# Required. SQLAlchemy URL using the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ai_interview_coach

# development | test | production  (production disables /docs and /openapi.json)
ENVIRONMENT=development

API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated exact origins allowed to call the API. '*' is rejected.
CORS_ORIGINS=http://localhost:3000

# Marks the session cookie Secure (HTTPS only). true whenever the API is served over HTTPS;
# false for plain-HTTP local development, or the browser drops the cookie.
# (COOKIE_SECURE is accepted as an alias for AUTH_COOKIE_SECURE).
AUTH_COOKIE_SECURE=false
COOKIE_SECURE=false
# COOKIE_SAMESITE: lax (default & recommended for custom domain topology) or none
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN: Leave empty/omitted for host-only cookies scoped to api.YOUR_DOMAIN (recommended).
# Set to .YOUR_DOMAIN only if sharing cookie across multiple subdomains is strictly required.
COOKIE_DOMAIN=

# ---------- Supabase Auth & Session Security ----------
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_ANON_KEY=
# Required in production for remote session revocation on logout
SUPABASE_SERVICE_ROLE_KEY=

# Server-Side AES-256-GCM Refresh Token Encryption Key (64-char hex string: openssl rand -hex 32)
SESSION_ENCRYPTION_KEY=
SESSION_KEY_ID=k1
# Optional fallback key during zero-downtime key rotation
SESSION_ENCRYPTION_KEY_FALLBACK=
SESSION_FALLBACK_KEY_ID=k0

# Public URLs for BFF and Frontend
FASTAPI_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# The app's own log lines on stderr: ids, enum codes, timings and model-call metadata, never
# resume text, answers, prompts, model output or keys. DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Largest accepted resume PDF, in whole MB (1-20). Larger uploads get 413 and are not read further.
MAX_RESUME_SIZE_MB=5

# ---------- AI model gateway (optional) ----------
# Empty = AI disabled; resume upload and rule-based extraction work without it.
# Comma-separated, in order: first is the primary, the rest are fallbacks. groq | gemini | nvidia
# Every provider listed needs both its *_API_KEY and *_MODEL, or the backend refuses to start.
AI_PROVIDERS=
# Per attempt. Worst case per AI request: providers x (AI_MAX_RETRIES + 1) x timeout + backoff.
AI_TIMEOUT_SECONDS=20
# Extra attempts per provider, for transient errors only (timeouts, 429, 5xx, invalid output).
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=8192
# Model-backed requests admitted per UTC day across ALL candidates: the cost circuit breaker.
# Size it from your provider plan. When it is reached, planning, question wording and evaluation
# use the deterministic rules instead, and AI extraction answers 429. 0 = never call a model.
# (Per-candidate daily limits and per-network sign-in limits are fixed in app/services/limits.py.)
AI_DAILY_REQUEST_LIMIT=2000

# Keys are secrets: set them only in backend/.env (never here, never in the frontend).
# Choose models that support JSON-schema structured output on that provider.
# Live-verified 2026-10-01: GROQ_MODEL=openai/gpt-oss-120b, GEMINI_MODEL=gemini-2.5-flash,
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b. Re-run tests/test_live_providers.py if you change one.
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Tests never use DATABASE_URL directly: they use the same URL with '_test' appended to the
# database name (e.g. ai_interview_coach_test), which must exist. To use a different database,
# export TEST_DATABASE_URL in your shell (it is read from the environment, not from this file).
